# Meeting mode: the TypeSafe (Jev) decision model, called only by the local dev/preview server (/api/decide).
# Copy this file to .env and fill in the key there. .env is gitignored. Never paste the key into chat, issues,
# PRs, commits or a VITE_ variable (VITE_ variables are bundled into the browser).
# Without a key the app uses かんたんモード (keyword rules), so the key is optional.
TYPESAFE_API_KEY=
# Set to "proxy" when an egress proxy adds the Authorization header itself (cloud Network secrets);
# then leave TYPESAFE_API_KEY empty and the key never enters this process.
TYPESAFE_AUTH=
TYPESAFE_MODEL=jev-latest
