{
  "name": "forecast-desk",
  "version": "1.0.0",
  "description": "FP&A rolling-forecast application with WebMCP tools, sandboxed GenUI and PDF reporting",
  "scripts": {
    "dev": "npm run sandbox:build && concurrently -k -n app,sandbox,sdk -c blue,magenta,gray \"vite\" \"node server/sandbox-server.mjs\" \"vite build -c vite.sandbox.config.ts --watch --logLevel warn\"",
    "sandbox:build": "vite build -c vite.sandbox.config.ts --logLevel warn",
    "sandbox:serve": "node server/sandbox-server.mjs",
    "build": "tsc --noEmit && vite build && npm run sandbox:build",
    "preview": "npm run build && concurrently -k -n app,sandbox \"vite preview\" \"node server/sandbox-server.mjs\"",
    "typecheck": "tsc --noEmit",
    "test:security": "playwright test tests/security",
    "test:e2e": "playwright test tests/e2e",
    "test": "playwright test",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@json-render/core": "^0.22.0",
    "@json-render/react": "^0.22.0",
    "@json-render/react-pdf": "^0.22.0",
    "@mcp-b/global": "^6.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "@ui-sdk/core": "^0.1.0-beta.2",
    "@ui-sdk/react": "^0.1.0-beta.2",
    "apache-arrow": "^21.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sucrase": "^3.35.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 || >=22.12"
  }
}
